# ---------------------------------------------------------
# Google AI Studio API Key
# ---------------------------------------------------------
GOOGLE_AI_STUDIO_API_KEY=

# ---------------------------------------------------------
# HuggingFace Personal Access Token
# ---------------------------------------------------------
HF_TOKEN=

# ---------------------------------------------------------
# Azure AI Translator
# ---------------------------------------------------------
# Standard NMT (v3.0) uses a Translator resource key.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Generative translation (2026-06-06) requires a Foundry (AIServices)
# resource with a deployed model. Set the resource endpoint and deployment.
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_DEPLOYMENT=gpt-5.4-mini